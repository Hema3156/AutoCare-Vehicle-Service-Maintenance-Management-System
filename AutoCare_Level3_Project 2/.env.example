# Copy to .env.local and fill in. Never commit .env.local.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=autocare_app
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=AutoCareDB

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=autocare

# Long random string, e.g.  openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# Optional: privileged account used ONLY by `npm run db:setup` (creating triggers/functions
# needs SUPER or log_bin_trust_function_creators=1). The app itself uses MYSQL_USER above.
# MYSQL_ADMIN_USER=root
# MYSQL_ADMIN_PASSWORD=
